# MINYAWE-LINK V8.0 — Environment variables
# على Vercel: كلها تتضاف من Project Settings → Environment Variables
# DATABASE_URL بتتوصل أوتوماتيك لما تربط Vercel Postgres بالمشروع

# مطلوب للوحة الأدمن + API الإدارة
ADMIN_TOKEN=change-me-strong-secret

# قاعدة البيانات (أوتوماتيك من Vercel Postgres)
# DATABASE_URL=postgres://...

# مفتاح Pixeldrain — مزود ثاني في السلسلة (20GB + keep-alive يومي ضد حذف عدم النشاط)
PIXELDRAIN_API_KEY=

# أقصى حجم ملف للرفع المباشر من المتصفح (حد OnlyFiles = 100MB)
MAX_FILE_SIZE_MB=100

# حد الطلبات لكل IP كل 10 دقائق
RATE_MAX=60

# اختياري: يثبت الدومين في اللينكات المولدة (يتكتشف تلقائياً غالباً)
# BASE_URL=https://minyawe-link.vercel.app

# اختياري: حسابك في Catbox — لكن افتراضياً catbox خارج السلسلة تماماً
# (بيحجب كل عناوين IP المراكز البيانات وفيها سيرفرات Vercel — اتجرب واتأكد)
# لو معاك بروكسي IP سكني شغال فعّل الاثنين مع بعض:
# ENABLE_CATBOX=true
# CATBOX_USERHASH=

# اختياري (موصى به): سر إضافي لحماية مسار الـ cron (Vercel Cron بيبعت header خاص أصلاً)
# CRON_SECRET=
